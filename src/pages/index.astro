---
import Layout from '../layouts/Layout.astro';
---

<Layout title="travis.lol">
  <section class="hero container">
    <!-- Pixel robot mascot -->
    <div class="hero-avatar" aria-hidden="true">
      <svg width="80" height="80" viewBox="0 0 10 10" style="image-rendering:pixelated">
        <!-- antenna -->
        <rect x="4" y="0" width="2" height="1" fill="#a855f7"/>
        <rect x="4" y="1" width="1" height="1" fill="#a855f7"/>
        <!-- head -->
        <rect x="2" y="2" width="6" height="4" fill="#6366f1"/>
        <!-- eyes -->
        <rect x="3" y="3" width="2" height="2" fill="#00d4ff"/>
        <rect x="7" y="3" width="2" height="2" fill="#00d4ff"/>
        <!-- eye glow -->
        <rect x="4" y="4" width="1" height="1" fill="#ffffff"/>
        <rect x="8" y="4" width="1" height="1" fill="#ffffff"/>
        <!-- mouth -->
        <rect x="3" y="5" width="1" height="1" fill="#ff6600"/>
        <rect x="5" y="5" width="1" height="1" fill="#ff6600"/>
        <rect x="7" y="5" width="1" height="1" fill="#ff6600"/>
        <!-- body -->
        <rect x="3" y="6" width="4" height="3" fill="#a855f7"/>
        <!-- core -->
        <rect x="4" y="7" width="2" height="1" fill="#00ff41"/>
        <!-- legs -->
        <rect x="3" y="9" width="1" height="1" fill="#6366f1"/>
        <rect x="6" y="9" width="1" height="1" fill="#6366f1"/>
      </svg>
    </div>

    <div class="hero-text">
      <h1 class="glitch">travis.lol</h1>
      <p class="hero-sub prompt">devsecops eng · threat modeler · homelab builder</p>
      <p class="hero-desc">
        Embedding security into pipelines, threat modeling product lines, and building risk frameworks
        by day. Running local AI stacks, writing C for Flipper Zero, and building offline pocket tools by night.
      </p>
      <div class="hero-tags">
        <span class="badge badge-green">DevSecOps</span>
        <span class="badge badge-cyan">Threat Modeling</span>
        <span class="badge badge-purple">Security Automation</span>
        <span class="badge badge-cyan">Flipper Zero</span>
        <span class="badge badge-green">Local AI</span>
        <span class="badge badge-orange">Cloudflare</span>
      </div>
    </div>
  </section>

  <hr class="pixel container" style="max-width:960px;margin:2rem auto;" />

  <section class="grid-section container">
    <h2 class="section-title">// latest</h2>
    <div class="card-grid">

      <a href="/work" class="card card-link">
        <div class="card-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 8 8" style="image-rendering:pixelated">
            <!-- shield body -->
            <rect x="2" y="0" width="4" height="1" fill="#a855f7"/>
            <rect x="1" y="1" width="6" height="5" fill="#a855f7"/>
            <rect x="2" y="6" width="4" height="1" fill="#a855f7"/>
            <rect x="3" y="7" width="2" height="1" fill="#a855f7"/>
            <!-- shield inner -->
            <rect x="2" y="2" width="4" height="3" fill="#080010"/>
            <!-- lock shackle -->
            <rect x="3" y="2" width="2" height="1" fill="#00d4ff"/>
            <!-- lock body -->
            <rect x="2" y="3" width="4" height="2" fill="#00d4ff"/>
            <!-- keyhole -->
            <rect x="3" y="3" width="2" height="1" fill="#080010"/>
            <rect x="3" y="4" width="1" height="1" fill="#080010"/>
          </svg>
        </div>
        <h3>Work</h3>
        <p>Career path from help desk to DevSecOps — security automation, threat modeling, risk frameworks.</p>
        <span class="badge badge-purple mt-2">career →</span>
      </a>

      <a href="/ai-stack" class="card card-link">
        <div class="card-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 8 8" style="image-rendering:pixelated">
            <rect x="1" y="0" width="6" height="1" fill="#a855f7"/>
            <rect x="0" y="1" width="8" height="5" fill="#080010"/>
            <rect x="1" y="2" width="2" height="1" fill="#00ff41"/>
            <rect x="4" y="2" width="3" height="1" fill="#6366f1"/>
            <rect x="1" y="4" width="5" height="1" fill="#ff6600"/>
            <rect x="0" y="6" width="8" height="1" fill="#a855f7"/>
          </svg>
        </div>
        <h3>AI Home Stack</h3>
        <p>My $44/mo AI setup — Copilot Pro+, CF Workers, local GPUs &amp; a home server.</p>
        <span class="badge badge-green mt-2">live →</span>
      </a>

      <a href="/projects" class="card card-link">
        <div class="card-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 8 8" style="image-rendering:pixelated">
            <rect x="0" y="1" width="8" height="6" fill="#0e0020"/>
            <rect x="1" y="2" width="6" height="4" fill="#080010"/>
            <rect x="2" y="3" width="4" height="1" fill="#00d4ff"/>
            <rect x="2" y="5" width="2" height="1" fill="#a855f7"/>
            <rect x="0" y="0" width="2" height="1" fill="#ff6600"/>
            <rect x="3" y="0" width="2" height="1" fill="#ff6600"/>
            <rect x="6" y="0" width="2" height="1" fill="#ff6600"/>
          </svg>
        </div>
        <h3>Projects</h3>
        <p>Things I've built. Workers, tools, experiments, and whatever else escapes the lab.</p>
        <span class="badge badge-cyan mt-2">view all →</span>
      </a>

      <a href="/flipper" class="card card-link">
        <div class="card-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 8 8" style="image-rendering:pixelated">
            <rect x="1" y="0" width="6" height="8" fill="#0e0020"/>
            <rect x="2" y="1" width="4" height="1" fill="#a855f7"/>
            <rect x="2" y="2" width="4" height="3" fill="#080010"/>
            <rect x="3" y="3" width="2" height="1" fill="#00ff41"/>
            <rect x="2" y="6" width="1" height="1" fill="#00d4ff"/>
            <rect x="4" y="6" width="1" height="1" fill="#ff6600"/>
            <rect x="6" y="2" width="1" height="4" fill="#a855f7"/>
          </svg>
        </div>
        <h3>Flipper Field Decks</h3>
        <p>DiscDeck joins ThreatDeck, BlackoutDeck, and TabletopDeck in the rat[0] Flipper app stack.</p>
        <span class="badge badge-gold mt-2">disc golf →</span>
      </a>

      <a href="/ops" class="card card-link">
        <div class="card-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 8 8" style="image-rendering:pixelated">
            <rect x="0" y="1" width="8" height="6" fill="#080010"/>
            <rect x="1" y="2" width="6" height="1" fill="#00ff41"/>
            <rect x="1" y="4" width="2" height="1" fill="#a855f7"/>
            <rect x="4" y="4" width="3" height="1" fill="#00d4ff"/>
            <rect x="1" y="6" width="5" height="1" fill="#ff6600"/>
            <rect x="0" y="0" width="8" height="1" fill="#a855f7"/>
          </svg>
        </div>
        <h3>Ops Cockpit</h3>
        <p>Public-safe DevSecOps evidence wall: pipeline gates, controls, deploy rail, and threat model.</p>
        <span class="badge badge-purple mt-2">controls →</span>
      </a>

      <a href="https://chat.travis.lol" class="card card-link" target="_blank" rel="noopener">
        <div class="card-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 8 8" style="image-rendering:pixelated">
            <rect x="2" y="0" width="4" height="1" fill="#a855f7"/>
            <rect x="1" y="1" width="6" height="4" fill="#6366f1"/>
            <rect x="2" y="2" width="1" height="1" fill="#00d4ff"/>
            <rect x="5" y="2" width="1" height="1" fill="#00d4ff"/>
            <rect x="2" y="4" width="4" height="1" fill="#ff6600"/>
            <rect x="1" y="5" width="6" height="2" fill="#0e0020"/>
            <rect x="2" y="6" width="4" height="1" fill="#00ff41"/>
          </svg>
        </div>
        <h3>Private AI Chat</h3>
        <p>Cloudflare Agents voice + text chat with Gemma 4 by default, live model switching, and pixel UI.</p>
        <span class="badge badge-orange mt-2">open chat ↗</span>
      </a>

      <a href="/uses" class="card card-link">
        <div class="card-icon" aria-hidden="true">
          <svg width="32" height="32" viewBox="0 0 8 8" style="image-rendering:pixelated">
            <rect x="2" y="0" width="4" height="1" fill="#ffd700"/>
            <rect x="1" y="1" width="6" height="5" fill="#0e0020"/>
            <rect x="2" y="2" width="4" height="1" fill="#00ff41"/>
            <rect x="2" y="4" width="3" height="1" fill="#ffd700"/>
            <rect x="3" y="6" width="2" height="2" fill="#a855f7"/>
            <rect x="1" y="7" width="6" height="1" fill="#6366f1"/>
          </svg>
        </div>
        <h3>Uses</h3>
        <p>Hardware, software, and tools I actually use day to day — including my local AI rigs.</p>
        <span class="badge badge-gold mt-2">gear list →</span>
      </a>

    </div>
  </section>

  <section class="status-bar container">
    <div class="status-inner">
      <span class="status-dot"></span>
      <span class="text-pixel text-dim">system online</span>
      <span class="text-pixel text-dim">|</span>
      <span class="text-pixel text-green">devsecops ✓</span>
      <span class="text-pixel text-dim">|</span>
      <span class="text-pixel text-cyan">threat model active ✓</span>
      <span class="text-pixel text-dim">|</span>
      <span class="text-pixel text-orange">cf workers ✓</span>
      <span class="text-pixel text-dim">|</span>
      <span class="text-pixel text-purple">local gpu ✓</span>
      <span class="text-pixel text-dim">|</span>
      <span class="text-pixel text-green">tabletopdeck ✓</span>
      <span class="text-pixel text-dim">|</span>
      <span class="text-pixel text-gold">discdeck ✓</span>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    padding-top: 4rem;
    padding-bottom: 2rem;
    flex-wrap: wrap;
  }
  .hero-avatar {
    flex-shrink: 0;
    filter: drop-shadow(0 0 12px rgba(168,85,247,.6));
    animation: float 3s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-6px); }
  }
  .hero-text { flex: 1; min-width: 240px; }
  .hero-sub  { color: var(--green); margin: 0.75rem 0; font-size: 12px; }
  .hero-desc { color: var(--dim); max-width: 520px; margin-bottom: 1.5rem; }
  .hero-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .section-title {
    font-family: var(--pixel);
    font-size: 10px;
    color: var(--dim);
    margin-bottom: 1.5rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }
  .card-link h3 { margin: 0.75rem 0 0.5rem; }
  .card-link p  { color: var(--dim); font-size: 13px; }
  .card-icon    { margin-bottom: 0.5rem; }

  .status-bar {
    margin-top: 4rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--card-border);
    background: var(--card-bg);
  }
  .status-inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 8px;
  }
  .status-dot {
    width: 8px; height: 8px;
    background: var(--green);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--green);
    animation: blink 2s step-end infinite;
  }
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
</style>
