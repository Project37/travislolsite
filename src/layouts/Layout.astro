---
import Nav from '../components/Nav.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'travis.lol',
  description = 'Travis — DevSecOps engineer, threat modeler, homelab builder',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title === 'travis.lol' ? title : `${title} — travis.lol`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Pixel font + mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <span class="text-dim text-pixel">© 2026 travis.lol</span>
        <span class="text-dim text-pixel">built with astro + cloudflare workers</span>
        <span class="text-pixel" style="color:var(--purple)">▓▒░ pixel life ░▒▓</span>
      </div>
    </footer>
  </body>
</html>

<style>
  main {
    min-height: calc(100vh - 120px);
    padding-bottom: 4rem;
  }
  .site-footer {
    border-top: 2px solid var(--card-border);
    padding: 1.5rem 0;
    margin-top: 4rem;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 8px;
  }
</style>
