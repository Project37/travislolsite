---
const links = [
  { href: '/',          label: '~' },
  { href: '/work',      label: 'work' },
  { href: '/projects',  label: 'projects' },
  { href: '/ai-stack',  label: 'ai-stack' },
  { href: '/uses',      label: 'uses' },
];
const current = Astro.url.pathname;
---

<nav class="site-nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <svg width="16" height="16" viewBox="0 0 8 8" style="image-rendering:pixelated;vertical-align:middle;margin-right:8px;">
        <rect x="2" y="0" width="4" height="1" fill="#a855f7"/>
        <rect x="1" y="1" width="6" height="1" fill="#a855f7"/>
        <rect x="0" y="2" width="8" height="4" fill="#a855f7"/>
        <rect x="1" y="3" width="2" height="2" fill="#080010"/>
        <rect x="5" y="3" width="2" height="2" fill="#080010"/>
        <rect x="3" y="5" width="2" height="1" fill="#ff6600"/>
        <rect x="0" y="6" width="8" height="1" fill="#a855f7"/>
        <rect x="1" y="7" width="6" height="1" fill="#a855f7"/>
      </svg>
      travis.lol
    </a>
    <ul class="nav-links">
      {links.map(l => (
        <li>
          <a href={l.href} class={current === l.href || (l.href !== '/' && current.startsWith(l.href)) ? 'active' : ''}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(8, 0, 16, 0.9);
    border-bottom: 2px solid var(--card-border);
    backdrop-filter: blur(8px);
    padding: 0.75rem 0;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .nav-logo {
    font-family: var(--pixel);
    font-size: 10px;
    color: var(--purple) !important;
    text-decoration: none !important;
    white-space: nowrap;
  }
  .nav-links {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .nav-links a {
    font-family: var(--pixel);
    font-size: 8px;
    color: var(--dim);
    text-decoration: none;
    transition: color .15s;
  }
  .nav-links a:hover,
  .nav-links a.active {
    color: var(--green);
  }
  .nav-links a.active::before {
    content: '▶ ';
  }
</style>
