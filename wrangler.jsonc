{
	// Default config used for local dev (`wrangler dev`)
	"compatibility_date": "2026-05-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "travis-lol-dev",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},

	// Environments — deployed via GitHub Actions with `wrangler deploy --env <name>`
	"env": {
		// preview: ephemeral per-PR workers use --name override in CI, not this env directly
		"preview": {
			"name": "travis-lol-preview",
			"observability": {
				"enabled": true
			}
		},
		// production: the live site at travis.lol
		"production": {
			"name": "travis-lol",
			"observability": {
				"enabled": true
			}
		}
	}
}